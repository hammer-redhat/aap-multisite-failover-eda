---
# Namespace for the AAP deployment
namespace_site_one: "aap-26"
namespace_site_two: "aap-26-dr"

# Must match AnsibleAutomationPlatform metadata.name so the Operator can adopt the PVC
# "{{ aap_instance_name }}-hub-file-storage"; keep in sync across all site manifests you use together.
aap_instance_name: "aap-26"

# Postgres configuration
postgres_admin_user: ""
postgres_admin_password: ""
postgres_configure_host: "{{ db_host_site_one }}"
postgres_configure_port: "{{ db_port}}"
postgres_configure_sslmode: "{{ db_sslmode }}" # "disable", "require", "verify-full", "verify-ca"

# DB Cluster info: site one
db_host_site_one: ""
db_host_site_two: ""
db_port: ""
db_sslmode: "prefer" # "disable", "require", "verify-full", "verify-ca"
# Maps to operator_crs/secrets/external-postgres-configuration-controller.yml
# Flat names used by the Secret template (Jinja in that manifest)
db_name_controller: ""
db_password_controller: ""
db_username_controller: ""
# Maps to operator_crs/secrets/external-postgres-configuration-eda.yml
# Flat names used by the Secret template (Jinja in that manifest)
db_name_eda: ""
db_password_eda: ""
db_username_eda: ""
# Maps to operator_crs/secrets/external-postgres-configuration-hub.yml
# Flat names used by the Secret template (Jinja in that manifest)
db_name_hub: ""
db_password_hub: ""
db_username_hub: ""
# Maps to operator_crs/secrets/external-postgres-configuration-gateway.yml
# Flat names used by the Secret template (Jinja in that manifest)
db_name_gateway: ""
db_password_gateway: ""
db_username_gateway: ""
# Maps to operator_crs/secrets/site_one/aap-26-controller-admin-password.yml
# Flat names used by the Secret template (Jinja in that manifest)
controller_admin_password: ""
# Maps to operator_crs/secrets/site_one/aap-26-admin-password.yml
# Flat names used by the Secret template (Jinja in that manifest)
aap_admin_password: ""
# Maps to operator_crs/secrets/site_one/aap-26-controller-secret-key.yml
# Flat names used by the Secret template (Jinja in that manifest)
controller_secret_key: ""
# Maps to operator_crs/secrets/site_one/aap-26-automationhub-db-fields-encryption.yml
# Flat names used by the Secret template (Jinja in that manifest)
automationhub_db_fields_encryption_key: ""
# Maps to operator_crs/secrets/site_one/aap-db-fields-encryption-secret.yml
# Flat names used by the Secret template (Jinja in that manifest)
aap_db_fields_encryption_key: ""
# Maps to operator_crs/secrets/site_one/aap-26-eda-db-fields-encryption-secret.yml
# Flat names used by the Secret template (Jinja in that manifest)
aap_eda_db_fields_encryption_key: ""

# --- Automation Hub content storage (exclusive: set hub_content_storage_type to one backend) ---
# Leave hub_content_storage_type empty to omit extra hub persistence settings from the CR
# (operator default file storage). Use s3, azure, or file for explicit configuration.

# USE THIS FOR S3 STORAGE
# hub_content_storage_type: ""
# hub_object_storage_secret_name: ""
# hub_s3_access_key_id: ""
# hub_s3_secret_access_key: ""
# hub_s3_bucket_name: ""
# hub_s3_region: ""
# hub_s3_endpoint: ""   # optional — only needed for S3-compatible endpoints (e.g. MinIO)

# USE THIS FOR AZURE BLOB STORAGE
# hub_content_storage_type: "azure"
# hub_object_storage_secret_name: "aap-26-hub-object-storage"
# hub_azure_account_name: ""
# hub_azure_account_key: ""
# hub_azure_container: ""
# hub_azure_container_path: ""   # optional
# hub_azure_connection_string: ""  # optional

# USE THIS FOR NFS/FILE STORAGE — dynamic provisioning (cluster creates PVC from StorageClass)
# hub_content_storage_type: "file"
# hub_file_storage_provisioning: "dynamic"
# hub_file_storage_storage_class: ""  # e.g. an RWX-capable StorageClass (NFS-backed)
# hub_file_storage_size: "100Gi"

# USE THIS FOR NFS/FILE STORAGE — manual PV/PVC against an NFS export (before the AAP CR reconciles Hub)
# The playbooks render operator_crs/secrets/site_*/automation-hub-file-storage-nfs.yml — cluster-scoped PV
# plus PVC named "{{ aap_instance_name }}-hub-file-storage" per Red Hat static storage guidance (omit StorageClass).
# NFS server identifier is hostname or IP (export path below is server-side pathname for the NFS share root).
#
# hub_content_storage_type: "file"
# hub_file_storage_provisioning: "static_nfs"
# hub_file_storage_size: "100Gi"
# hub_file_storage_nfs_server: "nfs.customer.example.com"
# hub_file_storage_nfs_path: "/exports/ansible-automation-hub"
# hub_file_storage_pv_name: "aap-hub-content-nfs-pv"
# Separate PV names required if both site playbooks deploy to the same Kubernetes cluster:
# hub_file_storage_pv_name_site_one: ""
# hub_file_storage_pv_name_site_two: ""

# --- Observability Dashboard ---

# Grafana instance (pre-existing, external host)
grafana_url: "https://grafana.example.com"
grafana_api_token: ""  # Grafana service account token with Editor role

# postgres_check container image (must match the image used in openshift-deployment.example.yaml)
postgres_check_image: "quay.io/chrhamme/postgres-check:v5"

# OCP Thanos Querier endpoints — accessible from the Grafana host
# Find via: oc -n openshift-monitoring get route thanos-querier -o jsonpath='{.spec.host}'
thanos_querier_site_one: ""   # hostname only, e.g. thanos-querier-openshift-monitoring.apps.site1.example.com
thanos_querier_site_two: ""   # hostname only, e.g. thanos-querier-openshift-monitoring.apps.site2.example.com

# OCP Service Account tokens with cluster-monitoring-view role for each cluster
# Create via: oc -n openshift-monitoring create token prometheus-k8s --duration=8760h
thanos_bearer_token_site_one: ""
thanos_bearer_token_site_two: ""

# Site labels — must match the SITE_LABEL env var used in the Deployment (and the site label in ServiceMonitor)
site_label_one: "site1"
site_label_two: "site2"

# AAP Gateway API credentials (for service status metrics)
# Find the gateway URL via: oc -n <namespace> get route <instance-name> -o jsonpath='{.spec.host}'
# Leave gateway_url_site_* empty to skip gateway status metrics for that site.
# gateway_password_site_* defaults to aap_admin_password if not set.
gateway_url_site_one: ""   # e.g. https://aap-26-aap-26.apps.site1.example.com
gateway_url_site_two: ""   # e.g. https://aap-26-aap-26.apps.site2.example.com
gateway_user: "admin"
# gateway_password_site_one: ""   # defaults to aap_admin_password
# gateway_password_site_two: ""   # defaults to aap_admin_password
gateway_ssl_verify: "false"       # set to "true" if the gateway uses a trusted certificate